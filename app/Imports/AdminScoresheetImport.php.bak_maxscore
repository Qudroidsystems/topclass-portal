<?php

namespace App\Imports;

use App\Models\BroadsheetRecord;
use App\Models\Broadsheets;
use App\Models\Schoolclass;
use App\Models\Student;
use App\Models\Subjectclass;
use Illuminate\Support\Collection;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Maatwebsite\Excel\Concerns\Importable;
use Maatwebsite\Excel\Concerns\SkipsFailures;
use Maatwebsite\Excel\Concerns\SkipsOnFailure;
use Maatwebsite\Excel\Concerns\ToCollection;

/**
 * TopClass admin scoresheet import.
 *
 * Fixed score columns (CA1, CA2, CA3, Exam) stored directly on `broadsheets`.
 * Matches App\Exports\AdminRecordsheetExport (headers "CA1 (100)" etc.) and uses
 * the same formulas as AdminScoreEntryController::bulkUpdate:
 *   total = round((avg(ca1,ca2,ca3) + exam) / 2, 1)
 *   cum   = term 1 ? total : round((bf + total) / 2, 2)
 *   grade = Classcategory::calculateGrade(cum)
 */
class AdminScoresheetImport implements ToCollection, SkipsOnFailure
{
    use Importable, SkipsFailures;

    protected const SCORE_FIELDS = ['ca1' => 'CA1', 'ca2' => 'CA2', 'ca3' => 'CA3', 'exam' => 'Exam'];
    protected const MAX_SCORE    = 100;

    protected array $importData;
    protected int   $successCount   = 0;
    protected array $importFailures = [];
    protected array $updatedIds     = [];
    protected       $schoolclass    = null;
    protected       $subjectId      = null;
    protected ?int  $canonicalStaffId = null;

    protected int   $admissionColumnIndex = -1;
    protected array $scoreColumnMap       = []; // field => column index
    protected int   $headerRowIndex       = -1;

    public function __construct(array $importData)
    {
        $this->importData = $importData;

        if (!empty($importData['schoolclass_id'])) {
            $this->schoolclass = Schoolclass::with('classcategory')->find($importData['schoolclass_id']);
        }

        if (!empty($importData['subjectclass_id'])) {
            $subjectClass    = Subjectclass::find($importData['subjectclass_id']);
            $this->subjectId = $subjectClass ? $subjectClass->subjectid : null;

            $staff = DB::table('subjectclass')
                ->join('subjectteacher', 'subjectteacher.id', '=', 'subjectclass.subjectteacherid')
                ->where('subjectclass.id', $importData['subjectclass_id'])
                ->value('subjectteacher.staffid');
            $this->canonicalStaffId = $staff ? (int) $staff : null;
        }
    }

    public function collection(Collection $rows): void
    {
        if ($rows->isEmpty()) {
            $this->importFailures[] = ['row' => 0, 'errors' => ['The Excel file is empty.']];
            return;
        }

        $this->findHeaderRow($rows);

        if ($this->headerRowIndex === -1) {
            $this->importFailures[] = ['row' => 0, 'errors' => [
                'Could not find the header row ("Admission No"). Please upload the file exported from this scoresheet without changing its structure.',
            ]];
            return;
        }

        $missing = array_diff(array_values(self::SCORE_FIELDS), array_map(
            fn ($f) => self::SCORE_FIELDS[$f],
            array_keys($this->scoreColumnMap)
        ));
        if (!empty($missing)) {
            $this->importFailures[] = ['row' => 0, 'errors' => [
                'Missing column(s) in the file: ' . implode(', ', $missing) . '. Nothing was imported.',
            ]];
            return;
        }

        DB::beginTransaction();

        try {
            foreach ($rows as $index => $row) {
                if ($index <= $this->headerRowIndex) {
                    continue;
                }

                $values = array_values(is_array($row) ? $row : $row->toArray());

                $adm = $values[$this->admissionColumnIndex] ?? null;
                if ($adm === null || trim((string) $adm) === '') {
                    continue;
                }

                try {
                    $this->processRow($values, $index + 1);
                } catch (\Throwable $e) {
                    $this->importFailures[] = ['row' => $index + 1, 'errors' => [$e->getMessage()]];
                    Log::warning('[AdminImport] Row ' . ($index + 1) . ': ' . $e->getMessage());
                }
            }

            DB::commit();

            session([
                'import_progress' => 100,
                'import_status'   => 'completed',
                'import_message'  => 'Import completed!',
            ]);
        } catch (\Throwable $e) {
            DB::rollBack();
            Log::error('[AdminImport] Transaction failed: ' . $e->getMessage());
            $this->successCount = 0;
            $this->updatedIds   = [];
            $this->importFailures[] = ['row' => 0, 'errors' => ['Transaction failed: ' . $e->getMessage()]];
        }
    }

    // ------------------------------------------------------------------
    // Header discovery
    // ------------------------------------------------------------------

    protected function findHeaderRow(Collection $rows): void
    {
        foreach ($rows as $index => $row) {
            $values = array_values(is_array($row) ? $row : $row->toArray());

            foreach ($values as $colIndex => $value) {
                if (!is_string($value) || strlen($value) > 40) {
                    continue; // title/banner rows are long text; headers are short
                }
                $lower = strtolower(trim($value));
                if (str_contains($lower, 'admission') || str_contains($lower, 'adm no') || str_contains($lower, 'student id')) {
                    $this->headerRowIndex       = $index;
                    $this->admissionColumnIndex = $colIndex;
                    $this->buildScoreColumnMap($values);
                    return;
                }
            }
        }
    }

    protected function buildScoreColumnMap(array $headerValues): void
    {
        foreach ($headerValues as $colIndex => $headerText) {
            if (!is_string($headerText) || trim($headerText) === '') {
                continue;
            }
            // "CA1 (100)" => "CA1"
            $clean = trim(preg_replace('/\s*\([^)]*\)/', '', $headerText));

            foreach (self::SCORE_FIELDS as $field => $label) {
                if (strcasecmp($clean, $label) === 0 && !isset($this->scoreColumnMap[$field])) {
                    $this->scoreColumnMap[$field] = $colIndex;
                }
            }
        }
    }

    // ------------------------------------------------------------------
    // Row processing
    // ------------------------------------------------------------------

    protected function processRow(array $values, int $rowNumber): void
    {
        $admissionNo = trim((string) $values[$this->admissionColumnIndex]);

        $student = Student::where('admissionNO', $admissionNo)->first();
        if (!$student) {
            throw new \Exception("Student '{$admissionNo}' not found.");
        }

        $record = BroadsheetRecord::where([
            'student_id'     => $student->id,
            'subject_id'     => $this->subjectId,
            'schoolclass_id' => $this->importData['schoolclass_id'],
            'session_id'     => $this->importData['session_id'],
        ])->first();

        $broadsheet = $record
            ? Broadsheets::where('broadsheet_record_id', $record->id)
                ->where('subjectclass_id', $this->importData['subjectclass_id'])
                ->where('term_id', $this->importData['term_id'])
                ->first()
            : null;

        // Read + validate scores first (nothing is written if any value is bad)
        $scores = [];
        foreach (self::SCORE_FIELDS as $field => $label) {
            $raw = $values[$this->scoreColumnMap[$field]] ?? null;

            if ($raw === null || (is_string($raw) && trim($raw) === '')) {
                $scores[$field] = $broadsheet ? (float) ($broadsheet->{$field} ?? 0) : 0.0; // blank = keep existing
                continue;
            }
            if (!is_numeric($raw)) {
                throw new \Exception("{$label} value '{$raw}' for '{$admissionNo}' is not a number.");
            }
            $n = (float) $raw;
            if ($n < 0 || $n > self::MAX_SCORE) {
                throw new \Exception("{$label} score ({$n}) for '{$admissionNo}' must be between 0 and " . self::MAX_SCORE . '.');
            }
            $scores[$field] = $n;
        }

        if (!$record) {
            $record = BroadsheetRecord::create([
                'student_id'     => $student->id,
                'subject_id'     => $this->subjectId,
                'schoolclass_id' => $this->importData['schoolclass_id'],
                'session_id'     => $this->importData['session_id'],
            ]);
        }

        if (!$broadsheet) {
            $broadsheet = new Broadsheets();
            $broadsheet->broadsheet_record_id = $record->id;
            $broadsheet->subjectclass_id      = $this->importData['subjectclass_id'];
            $broadsheet->term_id              = $this->importData['term_id'];
            $broadsheet->staff_id             = $this->canonicalStaffId ?? $this->importData['staff_id'];
            $broadsheet->entered_by           = auth()->id();
            $broadsheet->entered_at           = now();
            $broadsheet->entry_source         = 'admin_import';
            $broadsheet->save();
        } elseif (!$broadsheet->isEditableByTeacher()) {
            throw new \Exception("Scoresheet for '{$admissionNo}' is locked: "
                . ($broadsheet->lock_reason ?? 'locked by an administrator') . '.');
        }

        $termId = (int) $this->importData['term_id'];

        $caAverage = ($scores['ca1'] + $scores['ca2'] + $scores['ca3']) / 3;
        $total     = round(($caAverage + $scores['exam']) / 2, 1);
        $bf        = $this->getPreviousTermCum($student->id, $this->subjectId, $termId, (int) $this->importData['session_id']);
        $cum       = $termId === 1 ? $total : round(($bf + $total) / 2, 2);

        $grade = ($this->schoolclass && $this->schoolclass->classcategory)
            ? $this->schoolclass->classcategory->calculateGrade($cum)
            : $this->defaultGrade($cum);

        $broadsheet->update([
            'ca1'              => $scores['ca1'],
            'ca2'              => $scores['ca2'],
            'ca3'              => $scores['ca3'],
            'exam'             => $scores['exam'],
            'total'            => $total,
            'bf'               => $bf,
            'cum'              => $cum,
            'grade'            => $grade,
            'remark'           => $this->getRemark($grade),
            'last_modified_by' => auth()->id(),
            'last_modified_at' => now(),
            'entry_source'     => $broadsheet->entry_source ?: 'admin_import',
        ]);

        $this->updatedIds[] = $broadsheet->id;
        $this->successCount++;
    }

    // ------------------------------------------------------------------
    // Helpers (mirror AdminScoreEntryController)
    // ------------------------------------------------------------------

    protected function getPreviousTermCum(int $studentId, ?int $subjectId, int $termId, int $sessionId): float
    {
        if ($termId <= 1) {
            return 0.0;
        }

        $prev = DB::table('broadsheets')
            ->join('broadsheet_records', 'broadsheet_records.id', '=', 'broadsheets.broadsheet_record_id')
            ->where('broadsheet_records.student_id', $studentId)
            ->where('broadsheet_records.subject_id', $subjectId)
            ->where('broadsheet_records.session_id', $sessionId)
            ->where('broadsheets.term_id', $termId - 1)
            ->select(['broadsheets.cum', 'broadsheets.total'])
            ->first();

        if (!$prev) {
            return 0.0;
        }

        $value = ($prev->cum !== null && (float) $prev->cum != 0) ? $prev->cum : $prev->total;

        return $value !== null ? round((float) $value, 2) : 0.0;
    }

    protected function defaultGrade(float $score): string
    {
        if ($score >= 70) return 'A';
        if ($score >= 60) return 'B';
        if ($score >= 50) return 'C';
        if ($score >= 40) return 'D';
        return 'F';
    }

    protected function getRemark(string $grade): string
    {
        return match ($grade) {
            'A', 'A1'             => 'Excellent',
            'B', 'B2', 'B3'       => 'Very Good',
            'C', 'C4', 'C5', 'C6' => 'Good',
            'D', 'D7', 'E8'       => 'Pass',
            default               => 'Fail',
        };
    }

    // ------------------------------------------------------------------
    // Accessors
    // ------------------------------------------------------------------

    public function getSuccessCount(): int
    {
        return $this->successCount;
    }

    public function getFailures(): array
    {
        return $this->importFailures;
    }

    /** Fresh rows for the broadsheets touched by this import (ca fields + computed values). */
    public function getUpdatedBroadsheets(): array
    {
        if (empty($this->updatedIds)) {
            return [];
        }

        return Broadsheets::whereIn('id', $this->updatedIds)
            ->get(['id', 'ca1', 'ca2', 'ca3', 'exam', 'total', 'bf', 'cum', 'grade', 'remark'])
            ->toArray();
    }

    public function validateExcelFile($file): bool
    {
        if ($this->toCollection($file)->isEmpty()) {
            throw new \Exception('The Excel file is empty.');
        }
        return true;
    }
}
