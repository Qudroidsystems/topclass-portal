<?php

namespace App\Http\Controllers;

use App\Models\Broadsheets;
use App\Models\Schoolclass;
use App\Models\Schoolsession;
use App\Models\Schoolterm;
use App\Models\SchoolInformation;
use App\Models\Studentclass;
use App\Models\PromotionStatus;
use App\Models\Assessment;
use App\Models\BroadsheetAssessmentScore;
use Barryvdh\DomPDF\Facade\Pdf;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\View\View;
use Illuminate\Http\JsonResponse;

class TranscriptController extends Controller
{
    public function __construct()
    {
        $this->middleware('permission:View student-transcript');
    }

    // =========================================================================
    // INDEX
    // =========================================================================

    public function index(): View
    {
        $pagetitle     = 'Student Transcript Generator';
        $sessions      = Schoolsession::orderByDesc('id')->get();
        $terms         = Schoolterm::all();
        $schoolclasses = Schoolclass::leftJoin('schoolarm', 'schoolarm.id', '=', 'schoolclass.arm')
            ->select(['schoolclass.id', 'schoolclass.schoolclass', 'schoolarm.arm'])
            ->orderBy('schoolclass.schoolclass')
            ->get();

        return view('transcript.index', compact('pagetitle', 'sessions', 'terms', 'schoolclasses'));
    }

    // =========================================================================
    // SEARCH STUDENTS (AJAX)
    // =========================================================================

    public function searchStudents(Request $request): JsonResponse
    {
        $q         = $request->input('q', '');
        $sessionId = $request->input('session_id');
        $classId   = $request->input('class_id');

        $query = DB::table('studentRegistration as sr')
            ->leftJoin('studentpicture as sp',   'sp.studentid',   '=', 'sr.id')
            ->leftJoin('studentclass as sc',      'sc.studentId',   '=', 'sr.id')
            ->leftJoin('schoolclass as cls',      'cls.id',         '=', 'sc.schoolclassid')
            ->leftJoin('schoolarm as arm',        'arm.id',         '=', 'cls.arm')
            ->leftJoin('schoolsession as sess',   'sess.id',        '=', 'sc.sessionid')
            ->select([
                'sr.id',
                'sr.admissionNo as admissionno',
                'sr.firstname',
                'sr.lastname',
                'sr.othername',
                'sr.gender',
                'sp.picture',
                'cls.schoolclass',
                'arm.arm',
                'sess.session',
            ])
            ->where(function ($inner) use ($q) {
                $inner->where('sr.lastname',     'like', "%{$q}%")
                      ->orWhere('sr.firstname',  'like', "%{$q}%")
                      ->orWhere('sr.admissionNo','like', "%{$q}%");
            });

        if ($sessionId) $query->where('sc.sessionid', $sessionId);
        if ($classId)   $query->where('sc.schoolclassid', $classId);

        $students = $query->distinct()->orderBy('sr.lastname')->limit(30)->get();

        return response()->json(['success' => true, 'students' => $students]);
    }

    // =========================================================================
    // PREVIEW
    // =========================================================================

    public function preview(Request $request): View|JsonResponse|RedirectResponse
    {
        try {
            $validated = $request->validate([
                'student_id' => 'required|exists:studentRegistration,id',
                'type'       => 'nullable|in:full,term,session',
                'session_id' => 'nullable|exists:schoolsession,id',
                'term_id'    => 'nullable|exists:schoolterm,id',
            ]);

            $data = $this->buildTranscriptData(
                (int) $validated['student_id'],
                $validated['type']       ?? 'full',
                $validated['session_id'] ?? null,
                $validated['term_id']    ?? null,
            );

            $data['pagetitle']          = 'Student Transcript – ' . $data['student']->lastname . ' ' . $data['student']->firstname;
            $data['school_logo_base64'] = $this->getLogoBase64($data['schoolInfo']);

            return view('transcript.preview', $data);

        } catch (\Exception $e) {
            Log::error('Transcript preview error', ['error' => $e->getMessage()]);
            return back()->with('error', 'Failed to load transcript: ' . $e->getMessage());
        }
    }

    // =========================================================================
    // EXPORT PDF
    // =========================================================================

    public function exportPdf(Request $request): mixed
    {
        try {
            ini_set('max_execution_time', 300);
            ini_set('memory_limit', '512M');

            $validated = $request->validate([
                'student_id' => 'required|exists:studentRegistration,id',
                'type'       => 'nullable|in:full,term,session',
                'session_id' => 'nullable|exists:schoolsession,id',
                'term_id'    => 'nullable|exists:schoolterm,id',
                'copy_type'  => 'nullable|in:original,duplicate',
            ]);

            $data = $this->buildTranscriptData(
                (int) $validated['student_id'],
                $validated['type']       ?? 'full',
                $validated['session_id'] ?? null,
                $validated['term_id']    ?? null,
            );

            $data['school_logo_base64'] = $this->getLogoBase64($data['schoolInfo']);
            $data['copy_type']          = $validated['copy_type'] ?? 'original';
            $data['generated_at']       = now()->format('d M Y, H:i');
            $data['generated_by']       = auth()->user()->name ?? 'System';

            $pdf = Pdf::loadView('transcript.pdf', $data)
                ->setPaper('A4', 'portrait')
                ->setOptions([
                    'isHtml5ParserEnabled'    => true,
                    'isRemoteEnabled'         => true,
                    'isFontSubsettingEnabled' => true,
                    'defaultFont'             => 'DejaVu Sans',
                    'dpi'                     => 96,
                    'enable_css_float'        => false,
                    'enable_javascript'       => false,
                ]);

            $student  = $data['student'];
            $filename = 'Transcript_'
                . preg_replace('/[^A-Za-z0-9_\-]/', '_', trim($student->lastname . '_' . $student->firstname))
                . '_' . now()->format('Ymd') . '.pdf';

            return $pdf->stream($filename);

        } catch (\Exception $e) {
            Log::error('Transcript PDF error', ['error' => $e->getMessage()]);
            return back()->with('error', 'Failed to generate transcript: ' . $e->getMessage());
        }
    }

    // =========================================================================
    // BUILD TRANSCRIPT DATA
    // =========================================================================

    private function buildTranscriptData(
        int $studentId,
        string $type = 'full',
        ?int $sessionId = null,
        ?int $termId = null
    ): array {
        $schoolInfo = SchoolInformation::getActiveSchool() ?? new \stdClass();

        // ── Student info ──────────────────────────────────────────────────────
        $student = DB::table('studentRegistration as sr')
            ->leftJoin('studentpicture as sp', 'sp.studentid', '=', 'sr.id')
            ->where('sr.id', $studentId)
            ->select([
                'sr.id',
                'sr.admissionNo as admissionno',
                'sr.firstname',
                'sr.lastname',
                'sr.othername',
                'sr.gender',
                'sr.dateofbirth',
                'sr.phone_number as phone',
                'sr.home_address2 as address',
                'sp.picture',
            ])
            ->first();

        if (!$student) {
            throw new \Exception('Student not found.');
        }

        // ── Enrolments ────────────────────────────────────────────────────────
        $enrolmentQuery = Studentclass::where('studentId', $studentId)
            ->join('schoolclass',   'schoolclass.id',   '=', 'studentclass.schoolclassid')
            ->leftJoin('schoolarm', 'schoolarm.id',     '=', 'schoolclass.arm')
            ->join('schoolsession', 'schoolsession.id', '=', 'studentclass.sessionid')
            ->join('schoolterm',    'schoolterm.id',    '=', 'studentclass.termid')
            ->select([
                'studentclass.schoolclassid',
                'studentclass.termid',
                'studentclass.sessionid',
                'schoolclass.schoolclass',
                'schoolarm.arm',
                'schoolsession.session',
                'schoolterm.term',
                'schoolsession.id as session_id_val',
                'schoolterm.id as term_id_val',
            ]);

        if ($type === 'session' && $sessionId) {
            $enrolmentQuery->where('studentclass.sessionid', $sessionId);
        } elseif ($type === 'term' && $sessionId && $termId) {
            $enrolmentQuery->where('studentclass.sessionid', $sessionId)
                           ->where('studentclass.termid', $termId);
        }

        $enrolments = $enrolmentQuery
            ->orderBy('schoolsession.id')
            ->orderBy('schoolterm.id')
            ->get();

        // ── Assessments – per classcategory, not just the first enrolled class ─
        // A student's assessment structure can differ between classcategories
        // (e.g. Junior vs Senior) over a multi-year 'full' transcript, so we
        // resolve assessments per enrolment (keyed by schoolclassid) instead of
        // once from the first class. The header row the blade renders is the
        // union of assessment NAMES seen across every classcategory the student
        // passed through, in first-seen order — a term whose classcategory
        // doesn't define a given assessment just shows blank under that column.
        $assessmentsByClass     = [];
        $classcategoriesByClass = [];
        foreach ($enrolments as $enrolForAssessments) {
            $clsId = $enrolForAssessments->schoolclassid;
            if (isset($assessmentsByClass[$clsId])) {
                continue;
            }

            $schoolclass = Schoolclass::with('classcategories')->find($clsId);
            $classcategoriesByClass[$clsId] = $schoolclass?->classcategories;
            $assessmentsByClass[$clsId] = ($schoolclass && $schoolclass->classcategories)
                ? Assessment::where('classcategory_id', $schoolclass->classcategories->id)
                    ->orderBy('id')
                    ->get()
                : collect();
        }

        $assessments = collect();
        $seenNames   = [];
        foreach ($assessmentsByClass as $classAssessments) {
            foreach ($classAssessments as $a) {
                if (!in_array($a->name, $seenNames, true)) {
                    $seenNames[]   = $a->name;
                    $assessments[] = $a;
                }
            }
        }
        $assessments = collect($assessments);

        // ── Broadsheet records ────────────────────────────────────────────────
        $bsQuery = DB::table('broadsheets')
            ->join('broadsheet_records', 'broadsheet_records.id',       '=', 'broadsheets.broadsheet_record_id')
            ->join('subject',            'subject.id',                  '=', 'broadsheet_records.subject_id')
            ->join('schoolterm',         'schoolterm.id',               '=', 'broadsheets.term_id')
            ->join('schoolsession',      'schoolsession.id',            '=', 'broadsheet_records.session_id')
            ->join('schoolclass',        'schoolclass.id',              '=', 'broadsheet_records.schoolclass_id')
            ->leftJoin('schoolarm',      'schoolarm.id',                '=', 'schoolclass.arm')
            ->where('broadsheet_records.student_id', $studentId)
            ->select([
                'broadsheets.id as broadsheet_id',
                'broadsheet_records.session_id',
                'broadsheets.term_id',
                'broadsheet_records.schoolclass_id',
                'broadsheet_records.subject_id',
                'subject.subject as subject_name',
                'subject.subject_code',
                'broadsheets.total',
                'broadsheets.bf',
                'broadsheets.cum',
                'broadsheets.grade',
                'broadsheets.remark',
                'broadsheets.subject_position_class as position',
                'broadsheets.avg as class_average',
                'broadsheets.vettedstatus',
                'schoolterm.term',
                'schoolsession.session',
                'schoolclass.schoolclass',
                'schoolarm.arm',
            ]);

        if ($type === 'session' && $sessionId) {
            $bsQuery->where('broadsheet_records.session_id', $sessionId);
        } elseif ($type === 'term' && $sessionId && $termId) {
            $bsQuery->where('broadsheet_records.session_id', $sessionId)
                    ->where('broadsheets.term_id', $termId);
        }

        $allRecords = $bsQuery
            ->orderBy('schoolsession.id')
            ->orderBy('broadsheets.term_id')
            ->orderBy('subject.subject')
            ->get();

        // ── Fetch assessment scores for all broadsheet records ────────────────
        $broadsheetIds       = $allRecords->pluck('broadsheet_id')->unique()->filter()->toArray();
        $assessmentScoresAll = collect();

        if (!empty($broadsheetIds)) {
            $assessmentScoresAll = BroadsheetAssessmentScore::whereIn('broadsheet_id', $broadsheetIds)
                ->get()
                ->groupBy('broadsheet_id');
        }

        // ── Promotion history ─────────────────────────────────────────────────
        $promotions = DB::table('promotionStatus')
            ->join('schoolterm',    'schoolterm.id',    '=', 'promotionStatus.termid')
            ->join('schoolsession', 'schoolsession.id', '=', 'promotionStatus.sessionid')
            ->join('schoolclass',   'schoolclass.id',   '=', 'promotionStatus.schoolclassid')
            ->leftJoin('schoolarm', 'schoolarm.id',     '=', 'schoolclass.arm')
            ->where('promotionStatus.studentId', $studentId)
            ->select([
                'promotionStatus.promotionStatus',
                'promotionStatus.classstatus',
                'promotionStatus.position',
                'schoolterm.term',
                'schoolsession.session',
            ])
            ->orderBy('schoolsession.id')
            ->orderBy('schoolterm.id')
            ->get()
            ->keyBy(fn ($r) => $r->session . '_' . $r->term);

        // ── Principal's comments ──────────────────────────────────────────────
        $comments = DB::table('studentpersonalityprofiles')
            ->join('schoolterm',    'schoolterm.id',    '=', 'studentpersonalityprofiles.termid')
            ->join('schoolsession', 'schoolsession.id', '=', 'studentpersonalityprofiles.sessionid')
            ->where('studentpersonalityprofiles.studentid', $studentId)
            ->select([
                'studentpersonalityprofiles.principalscomment',
                'schoolterm.term',
                'schoolsession.session',
            ])
            ->get()
            ->keyBy(fn ($r) => $r->session . '_' . $r->term);

        // ── Structure: session → term → subjects ──────────────────────────────
        $transcriptData  = [];
        $healingCache    = [];
        $gradeScalesUsed = [];

        foreach ($enrolments as $enrol) {
            $sessionKey = $enrol->session;
            $termKey    = $enrol->term;
            $mapKey     = $sessionKey . '_' . $termKey;

            if (!isset($transcriptData[$sessionKey])) {
                $transcriptData[$sessionKey] = [
                    'session'    => $sessionKey,
                    'session_id' => $enrol->session_id_val,
                    'terms'      => [],
                ];
            }

            $termRecords = $allRecords->filter(
                fn ($r) => $r->session === $sessionKey && $r->term === $termKey
            );

            $subjects     = [];
            $totalScore   = 0;
            $totalCum     = 0;
            $subjectCount = 0;

            $termAssessments = $assessmentsByClass[$enrol->schoolclassid] ?? collect();

            // Live, class-wide healed total/cum/bf + positions for this
            // class/term/session (see buildClassTermHealing() doc comment).
            // Cached per class/term/session since a 'full' transcript loops
            // this once per enrolled term and the combo won't repeat within
            // one student's own history.
            $healingKey = $enrol->schoolclass . '|' . $enrol->term_id_val . '|' . $enrol->session_id_val;
            $healing    = $healingCache[$healingKey]
                ??= $this->buildClassTermHealing(
                    $enrol->schoolclass,
                    (int) $enrol->term_id_val,
                    (int) $enrol->session_id_val
                );

            foreach ($termRecords as $rec) {
                // Build assessment scores for this subject row. Look the score up
                // under THIS term's own classcategory assessment id (matched to the
                // unified header column by name, since ids differ per
                // classcategory) rather than the first-enrolled class's id, so a
                // student who moved classcategory mid-transcript still shows real
                // scores for every term instead of blanks after the first change.
                $assessmentScoreRow = $assessmentScoresAll->get($rec->broadsheet_id, collect());
                $assessmentData     = [];
                foreach ($assessments as $a) {
                    $termAssessment = $termAssessments->firstWhere('name', $a->name);
                    $score = $termAssessment
                        ? $assessmentScoreRow->firstWhere('assessment_id', $termAssessment->id)
                        : null;
                    $assessmentData[$a->id] = $score ? (float) $score->score : null;
                }

                // Healed total/cum/bf/position/class-average for THIS subject,
                // from the class-wide query above — falls back to the stored
                // broadsheets columns when the subject isn't in that map (e.g.
                // no score entered yet). Grade is NOT healed here: it is
                // already classcategory-aware (Senior A1-F9 vs Junior A-F,
                // via Classcategory::calculateGrade()) as stored, and
                // recomputing it with one fixed scale would mis-grade every
                // Junior-class subject.
                $healedRow = $healing['subjectHealed'][$studentId][(int) $rec->subject_id] ?? null;
                $subTotal  = $healedRow['total'] ?? (float) ($rec->total ?? 0);
                $subCum    = $healedRow['cum']   ?? (float) ($rec->cum   ?? 0);
                $subBf     = $healedRow['bf']    ?? (float) ($rec->bf    ?? 0);
                $subPos    = $healing['subjectRank'][(int) $rec->subject_id][$studentId]
                    ?? ($rec->position ?? null);
                $subAvg    = $healing['subjectAvg'][(int) $rec->subject_id]
                    ?? (float) ($rec->class_average ?? 0);

                $subjects[] = [
                    'subject'       => $rec->subject_name,
                    'subject_code'  => $rec->subject_code ?? '',
                    'assessments'   => $assessmentData,
                    'total'         => $subTotal,
                    'bf'            => $subBf,
                    'cum'           => $subCum,
                    'grade'         => $rec->grade ?? '-',
                    'remark'        => $rec->remark ?? '-',
                    'position'      => $this->formatOrdinal($subPos),
                    'class_average' => $subAvg,
                ];

                $totalScore   += $subTotal;
                $totalCum     += $subCum;
                $subjectCount++;
            }

            $termAvg   = $subjectCount > 0 ? round($totalScore / $subjectCount, 1) : 0;
            $cumAvg    = $subjectCount > 0 ? round($totalCum   / $subjectCount, 1) : 0;
            $promotion = $promotions[$mapKey] ?? null;
            $comment   = $comments[$mapKey]   ?? null;

            $computedPosition = $healing['overallRank'][$studentId] ?? null;

            // Classcategory (Junior/Senior) this term's class belongs to —
            // defaults to Senior when no classcategory row is found, matching
            // the app's long-standing default grading scale. Tracked per term
            // so the legend and overall GPA can be classcategory-correct
            // instead of always assuming Senior A1-F9, which mislabels a
            // Junior class's real A/B/C/D/F grades against a scale that
            // isn't theirs.
            $termClassCategory = $classcategoriesByClass[$enrol->schoolclassid] ?? null;
            $termIsSenior      = $termClassCategory ? (bool) $termClassCategory->is_senior : true;
            $gradeScalesUsed[$termIsSenior ? 'senior' : 'junior'] = true;

            $transcriptData[$sessionKey]['terms'][$termKey] = [
                'term'           => $termKey,
                'term_id'        => $enrol->term_id_val,
                'class'          => $enrol->schoolclass . ' ' . ($enrol->arm ?? ''),
                'subjects'       => $subjects,
                'subject_count'  => $subjectCount,
                'total_score'    => round($totalScore, 1),
                'average'        => $termAvg,
                'cum_average'    => $cumAvg,
                'promotion'      => $promotion?->promotionStatus ?? null,
                'class_position' => $computedPosition !== null ? $this->formatOrdinal($computedPosition) : null,
                'comment'        => $comment?->principalscomment ?? null,
                'is_senior'      => $termIsSenior,
            ];
        }

        // ── Overall GPA ───────────────────────────────────────────────────────
        // GPA is a Senior-only concept in this app (Classcategory only
        // defines a point scale for is_senior classes; Junior classes use a
        // coarse A/B/C/D/F letter grade with no point equivalent), so it's
        // computed only from subjects taken in Senior-classcategory terms. A
        // Junior-only transcript has no Senior terms to draw from, so
        // overallGpa/overallGpaGrade come back null and the blade hides the
        // GPA badge instead of showing a number that doesn't mean anything
        // for a Junior student.
        $seniorSchoolclassIds = collect($classcategoriesByClass)
            ->filter(fn ($cc) => $cc && $cc->is_senior)
            ->keys();

        $allTotals = $allRecords
            ->filter(fn ($r) => $seniorSchoolclassIds->contains($r->schoolclass_id))
            ->pluck('total')
            ->filter(fn ($v) => $v > 0);

        $overallGpa = $allTotals->count() > 0
            ? round($allTotals->map(fn ($s) => $this->getGradePoint((float) $s))->avg(), 2)
            : null;

        // ── Grade distribution ────────────────────────────────────────────────
        $gradeDistribution = $allRecords
            ->groupBy('grade')
            ->map(fn ($g) => $g->count())
            ->sortKeys();

        return [
            'schoolInfo'        => $schoolInfo,
            'student'           => $student,
            'transcriptData'    => $transcriptData,
            'allRecords'        => $allRecords,
            'assessments'       => $assessments,
            'overallGpa'        => $overallGpa,
            'overallGpaGrade'   => $overallGpa !== null ? $this->getGpaGrade($overallGpa) : null,
            'gradeDistribution' => $gradeDistribution,
            'gradeScalesUsed'   => array_keys($gradeScalesUsed),
            'type'              => $type,
            'sessionId'         => $sessionId,
            'termId'            => $termId,
            'totalSubjects'     => $allRecords->pluck('subject_name')->unique()->count(),
            'totalSessions'     => collect($transcriptData)->count(),
        ];
    }

    // =========================================================================
    // HELPERS
    // =========================================================================

    /**
     * Live, class-wide healed data for one class/term/session: per-student
     * overall cum average + rank (for the term's "class position" badge),
     * and per-student-per-subject healed total/cum/bf + per-subject class
     * rank + class average (for each subject row's Total/BF/Cum/Position/
     * Class Avg). Computed once per class/term/session and reused for every
     * student pulled from that class/term — the transcript already needs
     * this once per term, and per-subject positions need the same
     * class-wide cohort query the overall position does, so both come from
     * one query instead of one query per subject.
     *
     * Grade is deliberately NOT healed here — broadsheets.grade is already
     * computed classcategory-aware (Senior A1-F9 vs Junior A-F, via
     * Classcategory::calculateGrade()) at score-entry time and is trusted
     * as-is; recomputing it with a single fixed scale here would silently
     * mis-grade every Junior-class subject.
     *
     * promotionStatus.position is never actually populated anywhere in the
     * codebase (always null), and broadsheets.subject_position_class can go
     * stale if a recalculation was never triggered after scores changed —
     * so both class-wide positions are computed fresh instead of trusted
     * from stored values. total/bf/cum use the same healing formula as
     * BroadsheetController: total = round((ca1+ca2+ca3)/3 + exam)/2, cum =
     * total for term 1 else round((bf+total)/2, 2), bf = the previous
     * term's healed total (falling back to the stored bf column, then 0).
     * Scope is class-wide (all arms of the same class name), matching what
     * the report card shows as "Students in Class". Returns empty maps
     * (never throws) on any error or when nothing is scored — every lookup
     * against the result must be null-safe, since this display is
     * best-effort and must never break the transcript.
     */
    private function buildClassTermHealing(string $className, int $termid, int $sessionid): array
    {
        $empty = [
            'overallRank'   => [],
            'subjectHealed' => [],
            'subjectRank'   => [],
            'subjectAvg'    => [],
        ];

        try {
            $allArmIds = Schoolclass::where('schoolclass', $className)->pluck('id');
            if ($allArmIds->isEmpty()) {
                return $empty;
            }

            $classStudentIds = Studentclass::whereIn('schoolclassid', $allArmIds)
                ->where('termid', $termid)
                ->where('sessionid', $sessionid)
                ->pluck('studentId')
                ->map(fn ($v) => (int) $v)
                ->unique()
                ->values();

            if ($classStudentIds->isEmpty()) {
                return $empty;
            }

            $rows = DB::table('broadsheets')
                ->join('broadsheet_records', 'broadsheet_records.id', '=', 'broadsheets.broadsheet_record_id')
                ->whereIn('broadsheet_records.student_id', $classStudentIds)
                ->whereIn('broadsheet_records.schoolclass_id', $allArmIds)
                ->where('broadsheets.term_id', $termid)
                ->where('broadsheet_records.session_id', $sessionid)
                ->select([
                    'broadsheet_records.student_id',
                    'broadsheet_records.subject_id',
                    'broadsheets.ca1',
                    'broadsheets.ca2',
                    'broadsheets.ca3',
                    'broadsheets.exam',
                    'broadsheets.bf',
                ])
                ->get();

            if ($rows->isEmpty()) {
                return $empty;
            }

            // Previous term's healed total per student/subject, for the BF
            // fallback — same 'use total, not the stale cum column' fix used
            // elsewhere (ViewStudentReportController / BroadsheetController).
            $prevTerm   = Schoolterm::where('id', '<', $termid)->orderByDesc('id')->first();
            $prevTotals = [];
            if ($prevTerm) {
                $prevRows = DB::table('broadsheets')
                    ->join('broadsheet_records', 'broadsheet_records.id', '=', 'broadsheets.broadsheet_record_id')
                    ->whereIn('broadsheet_records.student_id', $classStudentIds)
                    ->whereIn('broadsheet_records.schoolclass_id', $allArmIds)
                    ->where('broadsheets.term_id', $prevTerm->id)
                    ->where('broadsheet_records.session_id', $sessionid)
                    ->select(['broadsheet_records.student_id', 'broadsheet_records.subject_id', 'broadsheets.total'])
                    ->get();
                foreach ($prevRows as $r) {
                    $prevTotals[(int) $r->student_id][(int) $r->subject_id] = (float) $r->total;
                }
            }

            $subjectHealed        = []; // studentId => subjectId => [total, cum, bf]
            $subjectCumsBySubject = []; // subjectId => studentId => cum
            $overallCumSums       = [];
            $overallCumCounts     = [];

            foreach ($rows as $row) {
                $sid = (int) $row->student_id;
                $sub = (int) $row->subject_id;

                $ca1   = (float) ($row->ca1  ?? 0);
                $ca2   = (float) ($row->ca2  ?? 0);
                $ca3   = (float) ($row->ca3  ?? 0);
                $exam  = (float) ($row->exam ?? 0);
                $caAvg = ($ca1 + $ca2 + $ca3) / 3;
                $total = round(($caAvg + $exam) / 2, 1);

                if ($total <= 0) {
                    continue; // not actually sat
                }

                $prevTotal = $prevTotals[$sid][$sub] ?? null;
                if ($prevTotal !== null && $prevTotal > 0) {
                    $bf = $prevTotal;
                } elseif (!empty($row->bf) && (float) $row->bf > 0) {
                    $bf = (float) $row->bf;
                } else {
                    $bf = 0.0;
                }

                $cum = $termid == 1 ? $total : round(($bf + $total) / 2, 2);

                $subjectHealed[$sid][$sub]       = ['total' => $total, 'cum' => $cum, 'bf' => $bf];
                $subjectCumsBySubject[$sub][$sid] = $cum;

                $overallCumSums[$sid]   = ($overallCumSums[$sid]   ?? 0) + $cum;
                $overallCumCounts[$sid] = ($overallCumCounts[$sid] ?? 0) + 1;
            }

            $overallAverages = [];
            foreach ($overallCumSums as $sid => $sum) {
                $overallAverages[$sid] = round($sum / $overallCumCounts[$sid], 4);
            }

            $subjectRank = [];
            $subjectAvg  = [];
            foreach ($subjectCumsBySubject as $sub => $cumsByStudent) {
                $subjectRank[$sub] = $this->competitionRank($cumsByStudent);
                $subjectAvg[$sub]  = count($cumsByStudent) > 0
                    ? round(array_sum($cumsByStudent) / count($cumsByStudent), 1)
                    : 0.0;
            }

            return [
                'overallRank'   => $this->competitionRank($overallAverages),
                'subjectHealed' => $subjectHealed,
                'subjectRank'   => $subjectRank,
                'subjectAvg'    => $subjectAvg,
            ];
        } catch (\Throwable $e) {
            Log::warning('buildClassTermHealing failed: ' . $e->getMessage(), [
                'class'      => $className,
                'term_id'    => $termid,
                'session_id' => $sessionid,
            ]);
            return $empty;
        }
    }

    /**
     * Competition rank (ties share a rank; the next distinct value resumes
     * at its 1-indexed position) of an [id => value] map, highest first.
     */
    private function competitionRank(array $valuesById): array
    {
        arsort($valuesById);

        $ranks   = [];
        $rank    = 0;
        $lastVal = null;
        $lastPos = 0;

        foreach ($valuesById as $id => $val) {
            $rank++;
            if ($lastVal !== null && $val === $lastVal) {
                $pos = $lastPos;
            } else {
                $pos     = $rank;
                $lastPos = $pos;
                $lastVal = $val;
            }
            $ranks[$id] = $pos;
        }

        return $ranks;
    }

    private function formatOrdinal($number): string
    {
        if (!is_numeric($number) || $number <= 0) return '-';

        $number        = (int) $number;
        $lastDigit     = $number % 10;
        $lastTwoDigits = $number % 100;

        if ($lastTwoDigits >= 11 && $lastTwoDigits <= 13) return $number . 'th';

        return $number . match ($lastDigit) {
            1       => 'st',
            2       => 'nd',
            3       => 'rd',
            default => 'th',
        };
    }

    private function getGradePoint(float $score): float
    {
        if ($score >= 75) return 5.0;
        if ($score >= 70) return 4.5;
        if ($score >= 65) return 4.0;
        if ($score >= 60) return 3.5;
        if ($score >= 55) return 3.0;
        if ($score >= 50) return 2.5;
        if ($score >= 45) return 2.0;
        if ($score >= 40) return 1.0;
        return 0.0;
    }

    private function getGpaGrade(float $gpa): string
    {
        if ($gpa >= 4.5) return 'A1';
        if ($gpa >= 4.0) return 'B2';
        if ($gpa >= 3.5) return 'B3';
        if ($gpa >= 3.0) return 'C4';
        if ($gpa >= 2.5) return 'C5';
        if ($gpa >= 2.0) return 'C6';
        if ($gpa >= 1.5) return 'D7';
        if ($gpa >= 1.0) return 'E8';
        return 'F9';
    }

    private function getLogoBase64($schoolInfo): string
    {
        $placeholder = 'data:image/svg+xml;base64,' . base64_encode(
            '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80">
                <rect width="80" height="80" rx="40" fill="#1e3a5f"/>
                <text x="40" y="45" text-anchor="middle" fill="white" font-family="Arial" font-size="14" font-weight="bold">SCH</text>
            </svg>'
        );

        if (!$schoolInfo || empty($schoolInfo->school_logo)) return $placeholder;

        $paths = [
            storage_path('app/public/' . $schoolInfo->school_logo),
            public_path('storage/' . $schoolInfo->school_logo),
            public_path($schoolInfo->school_logo),
        ];

        foreach ($paths as $path) {
            if (file_exists($path) && filesize($path) > 100) {
                $mime = mime_content_type($path) ?: 'image/jpeg';
                return 'data:' . $mime . ';base64,' . base64_encode(file_get_contents($path));
            }
        }

        return $placeholder;
    }
